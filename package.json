{
  "name": "useless-minecraft-launcher",
  "version": "1.0.0",
  "description": "一個立志於整合minecraft版本的啟動器專案",
  "homepage": "https://github.com/ABestCookie/useless-minecraft-launcher#readme",
  "bugs": {
    "url": "https://github.com/ABestCookie/useless-minecraft-launcher/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABestCookie/useless-minecraft-launcher.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "build": {
    "appId": "com.abestcookie.uselessminecraftlauncher",
    "productName": "Useless Minecraft Launcher",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "art/icon.ico"
    },
    "directories": {
      "output": "dist_electron"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "start python eel_sevrer.py",
    "dev_electron": "start electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0"
  }
}
